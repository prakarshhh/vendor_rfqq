I had a lot of people.d fill in ONE provider.
# .env is git-ignored. Never commit real keys.

# Which LLM to use: anthropic | gemini | mock
# (mock = offline keyword matcher, only for testing the app without an API key)
LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-5)
# LLM_MODEL=claude-sonnet-5

# --- Gemini (has a free tier) ---
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
# LLM_MODEL=gemini-2.5-flash
